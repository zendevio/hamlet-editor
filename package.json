{
	"name": "hamlet-editor",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"tauri": "tauri",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test tests/*.test.mjs",
		"i18n:generate": "node scripts/i18n.mjs --write --types-only",
		"i18n:check": "node scripts/i18n.mjs",
		"test:h1": "playwright test"
	},
	"devDependencies": {
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.12.3",
		"@types/node": "24.19.2",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"paneforge": "^1.0.2",
		"phosphor-svelte": "^3.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"vite": "^8.3.4"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.3",
		"@tauri-apps/plugin-store": "^2.5.0",
		"intl-messageformat": "12.1.3",
		"mode-watcher": "^1.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"packageManager": "pnpm@12.14.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/zendevio/hamlet-editor.git"
	},
	"homepage": "https://github.com/zendevio/hamlet-editor",
	"author": "Alin M. Gheorghe"
